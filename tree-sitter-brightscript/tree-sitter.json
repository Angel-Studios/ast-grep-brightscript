{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "brightscript",
      "camelcase": "Brightscript",
      "scope": "source.brs",
      "file-types": ["brs"],
      "injection-regex": "^brs$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "BrightScript grammar for tree-sitter / ast-grep",
    "authors": [{ "name": "ast-grep-brightscript" }]
  },
  "bindings": { "c": true, "go": false, "node": true, "python": false, "rust": false, "swift": false }
}
