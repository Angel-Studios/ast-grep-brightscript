{
  "//": "brighterscript (bsc) config for the Roku test harness. Runs compiler/",
  "//2": "validation diagnostics WITHOUT producing a .zip (createPackage:false).",
  "//3": "Run from the repo root with `npm run check`.",
  "rootDir": ".",
  "files": [
    "manifest",
    "source/**/*.brs",
    "source/**/*.bs",
    "components/**/*.brs",
    "components/**/*.bs",
    "components/**/*.xml"
  ],
  "createPackage": false,
  "copyToStaging": false,
  "diagnosticLevel": "info"
}
