<?xml version="1.0" encoding="utf-8" ?>
<!-- ResultRow: the custom MarkupList item component that renders ONE test
     assertion and colors itself GREEN when it passed and RED when it failed.
     This is what gives the harness true per-statement green/red output - a plain
     LabelList can only tint every row the same color. The MarkupList in
     MainScene.xml references this component via itemComponentName="ResultRow"
     and sets the interface fields below on each visible row. -->
<component name="ResultRow" extends="Group">

  <interface>
    <!-- These fields are populated by the MarkupList's row manager. width/height
         come from the list's itemSize; itemContent is this row's ContentNode;
         itemHasFocus/focusPercent track remote focus. -->
    <field id="width"        type="float"   onChange="onLayoutChanged" />
    <field id="height"       type="float"   onChange="onLayoutChanged" />
    <field id="itemContent"  type="node"    onChange="onItemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    <field id="focusPercent" type="float" />
  </interface>

  <!-- Component logic (sizing + the GREEN/RED coloring of each row). -->
  <script type="text/brightscript" uri="pkg:/components/ResultRow.brs" />

  <children>
    <!-- Highlight drawn behind the text only while this row has focus. -->
    <Rectangle id="focusBg" color="0x303048FF" visible="false" translation="[0, 0]" />
    <Label id="rowLabel"
           horizAlign="left"
           vertAlign="center"
           wrap="false"
           translation="[12, 0]">
      <Font role="font" uri="font:MediumSystemFont" size="30" />
    </Label>
  </children>

</component>
