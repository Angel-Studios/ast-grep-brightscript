{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "scenegraph",
      "camelcase": "Scenegraph",
      "scope": "source.scenegraph",
      "file-types": ["xml"],
      "injection-regex": "^(xml|scenegraph)$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Roku SceneGraph XML grammar for tree-sitter / ast-grep",
    "authors": [{ "name": "ast-grep-brightscript" }]
  },
  "bindings": { "c": true, "go": false, "node": true, "python": false, "rust": false, "swift": false }
}
